# iRacing telemetry folder path (WSL)
IRACING_TELEMETRY_PATH=/mnt/c/Users/{WINDOWS_USER}/Documents/iRacing/telemetry

# local storage path for Parquet files
DATA_PATH=data/bronze

# DuckDB database file path
DUCKDB_PATH=data/motor_analytics.duckdb

# agent polling interval in seconds
AGENT_POLL_INTERVAL=5
